
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="Mon, 22 Jul 2002 11:12:01 GMT" />
    <meta name="robots" content="index,follow">
    <meta name="Googlebot" content="index,follow">
    <meta name="revisit-after" content="1 days">

    <title>@ViewData["Title"] | @Helper.GlobalHelper.PageTitle</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="@ViewData["Title"] | @Helper.GlobalHelper.PageKeywords" />
    <meta name="news_keywords" content="@ViewData["Title"] | @Helper.GlobalHelper.PageTags" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@Helper.GlobalHelper.DomainName" />
    <link rel="icon" type="image/x-icon" href="@Helper.GlobalHelper.LogoURL">

    <link rel="canonical" href="@ViewData["URLCurrent"]" />
    <meta property="og:site_name" content="@Helper.GlobalHelper.DomainName" />
    <meta property="og:rich_attachment" content="true" />
    <meta property="og:type" content="article" />
    <meta property="article:publisher" content="@Helper.GlobalHelper.Facebook" />
    <meta property="og:url" itemprop="url" content="@ViewData["URLCurrent"]" />
    <meta property="og:image" itemprop="thumbnailUrl" content="@ViewData["URLImage"]" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="600" />
    <meta content="@ViewData["Title"] | @Helper.GlobalHelper.PageTitle" property="og:title" itemprop="headline" />
    <meta content="@ViewData["Title"] | @Helper.GlobalHelper.PageDescription" property="og:description" itemprop="description" />
    <meta content="@ViewData["Title"] | @Helper.GlobalHelper.PageKeywords" property="article:tag" />
    <meta content="news" itemprop="genre" name="medium" />
    <meta content="EN" itemprop="inLanguage" />
    <meta content="@ViewData["Title"] |  @Helper.GlobalHelper.PageTitle" itemprop="articleSection" />
    <meta content="@ViewData["Title"] |  @Helper.GlobalHelper.PageTitle" itemprop="sourceOrganization" name="source" />
    <meta content="2022-01-01T19:22:56+07:00" itemprop="datePublished" name="pubdate" />
    <meta content="2022-01-01T19:22:56+07:00" itemprop="dateModified" name="lastmod" />
    <meta content="2022-01-01T19:22:56+07:00" itemprop="dateCreated" />
    <meta name="copyright" content="@Helper.GlobalHelper.DomainName" />
    <meta name="author" content="@Helper.GlobalHelper.DomainName" />

    <meta name="twitter:card" value="summary" />
    <meta name="twitter:url" content="@ViewData["URLCurrent"]" />
    <meta name="twitter:title" content="@ViewData["Title"] | @Helper.GlobalHelper.PageTitle" />
    <meta name="twitter:description" content="@ViewData["Title"] | @Helper.GlobalHelper.PageDescription" />
    <meta name="twitter:image" content="@ViewData["URLImage"]" />
    <meta name="twitter:site" content="@Helper.GlobalHelper.Twitter" />
    <meta name="twitter:creator" content="@Helper.GlobalHelper.Twitter" />

    <link rel="apple-touch-icon-precomposed" href="@Helper.GlobalHelper.LogoURL" sizes="72x72">
    <link rel="apple-touch-icon-precomposed" href="@Helper.GlobalHelper.LogoURL" sizes="144x144">

    <link rel="apple-touch-icon-precomposed" href="@Helper.GlobalHelper.LogoURL" sizes="57x57">
    <link rel="apple-touch-icon-precomposed" href="@Helper.GlobalHelper.LogoURL" sizes="114x114">

    <link rel="nokia-touch-icon" href="@Helper.GlobalHelper.LogoURL">

    <link rel="apple-touch-icon-precomposed" href="@Helper.GlobalHelper.LogoURL" sizes="1x1">


    <meta name="its_url" content="@ViewData["URLCurrent"]" />
    <meta name="its_title" content="@ViewData["Title"] | @Helper.GlobalHelper.PageTitle" />
    <meta name="its_section" content="@ViewData["Title"] | @Helper.GlobalHelper.PageDescription" />
    <meta name="its_subsection" content="@ViewData["Title"] | @Helper.GlobalHelper.PageKeywords" />
    <meta name="its_tag" content="@ViewData["Title"] | @Helper.GlobalHelper.PageTags" />


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap"
          rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="@Helper.GlobalHelper.DomainURLSub/lib/animate/animate.min.css" rel="stylesheet">
    <link href="@Helper.GlobalHelper.DomainURLSub/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="@Helper.GlobalHelper.DomainURLSub/css/bootstrap.min.css" rel="stylesheet">
    <link href="@Helper.GlobalHelper.DomainURLSub/css/style.css" rel="stylesheet">
    <link href="@Helper.GlobalHelper.DomainURLSub/css/responsive.css" rel="stylesheet">
</head>

<body>
    @RenderBody()
    <footer>
        <div class="bg-white p-0">
            <div class="container-fluid bg-dark text-black-50 footer wow fadeIn" id="container-footer" data-wow-delay="0.1s">
                <div class="container">
                    <div class="row g-2" style="display:flex; justify-content: space-evenly;">
                        <div class="col-12 col-xs-12 col-sm-12 col-md-12 col-lg-8">
                            <div class="content-footer">
                                <ul class="main-footer">
                                    <li>
                                        <h6 class="text-white title-footer">
                                            <a href="https://localhost:7285/" title="CHI CỤC QUẢN LÝ CHẤT LƯỢNG NÔNG LÂM SẢN VÀ THỦY SẢN">CHI CỤC QUẢN LÝ CHẤT LƯỢNG NÔNG LÂM SẢN VÀ THỦY SẢN</a>
                                        </h6>
                                    </li>
                                    <li>
                                        <a href="#" class="text-white">
                                            ​Địa chỉ: Số 8, Đường Nguyễn Trung Trực, phường An
                                            Hội, Thành phố Bến Tre,
                                            tỉnh Bến Tre
                                        </a>
                                    </li>
                                    <li> <a href="#" class="text-white">Điện thoại: 02753 827 337</a></li>
                                    <li> <a href="#" class="text-white">Email : ccqlcl.snn@bentre.gov.vn</a></li>
                                    <li> <a href="#" class="text-white"> Ghi rõ nguồn 'attpnn.bentre.gov.vn' khi phát hành lại các nội dung, dữ liệu của trang thông tin này.</a></li>
                                </ul>
                            </div>
                        </div>
                        <p class="donvilienket"></p>
                        <div class="col-12 col-xs-12 col-sm-12  col-md-12 col-lg-4">
                            <ul class="main-footer">
                                <li><h6 class="text-white title-footer">Đơn Vị Liên Kết</h6></li>
                                <li>
                                    <a href="https://bentre.gov.vn/" title="Uỷ Ban Nhân Dân Tỉnh Bến Tre"
                                       class="text-white">
                                        Ủy ban nhân dân tỉnh Bến Tre
                                    </a>
                                </li>
                                <li>
                                    <a href="https://snnptnt.bentre.gov.vn/" title="Sở Nông Nghiệp Và Phát Triển Nông Thôn"
                                       class="text-white">
                                        Sở Nông nghiệp và Phát triển Nông thôn tỉnh Bến Tre
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.mard.gov.vn/Pages/default.aspx" class="text-white"
                                       title="Bộ Nông nghiệp và Phát triển nông thôn">
                                        Bộ Nông nghiệp và Phát triển nông thôn
                                    </a>
                                </li>
                                <li>
                                    <a href="http://www.nafiqad.gov.vn/" class="text-white"
                                       title="Cục Chất lượng, Chế biến và Phát triển thị trường">
                                        Cục Chất lượng, Chế biến và Phát triển thị trường
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="container">
                    <div class="copyright">
                        <div id="Dgk">
                            <a href="https://dgk.vn/" title="Công ty Cổ Phần Đầu Tư Digital Kingdom">
                                Đơn vị triển khai Công ty Cổ Phần Đầu Tư Digital Kingdom.
                            </a>
                        </div>
                    </div>
                </div>
                <div class="content-back-to-top">
                    <a style="position: fixed;" href="#"
                       class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Helper.GlobalHelper.DomainURLSub/lib/wow/wow.min.js"></script>
    <script src="@Helper.GlobalHelper.DomainURLSub/lib/easing/easing.min.js"></script>
    <script src="@Helper.GlobalHelper.DomainURLSub/lib/waypoints/waypoints.min.js"></script>
    <script src="@Helper.GlobalHelper.DomainURLSub/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="@Helper.GlobalHelper.DomainURLSub/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
